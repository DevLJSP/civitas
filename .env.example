DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/civitas?schema=public&connection_limit=5&pool_timeout=20&connect_timeout=10
# Pooled runtime URL (Supabase session pooler, port 5432) + direct URL for migrations.
# Production example:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20&connect_timeout=10
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/civitas?schema=public
# Production example (direct host from Supabase dashboard → Database settings):
# DIRECT_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
NODE_ENV=production
# Optional:
# GUILD_ID=  # set for instant guild command refresh during development
# LOG_LEVEL=info
